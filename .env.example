# Morning Rebel storefront environment.
#
# Copy to `.env` for local development (`.env` is git-ignored). In production,
# set these as Oxygen environment variables in Shopify admin
# (Hydrogen > your storefront > Storefront settings > Environments and variables)
# or pull them locally with `npx shopify hydrogen env pull`.
#
# Placeholders only. Never commit real values.
# PUBLIC_* values are sent to the browser by design. Everything else stays on
# the server.

# --- Required on the server -------------------------------------------------

# Signs the session cookie. At least 32 random characters. The app refuses to
# start with a shorter value. Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# --- Shopify (Oxygen injects these automatically once the project is linked) -

PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
# Server-only token. Never prefix with PUBLIC_ and never expose to the client.
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
# Domain Shopify checkout runs on, e.g. checkout.yourdomain.com or your-store.myshopify.com
PUBLIC_CHECKOUT_DOMAIN=""

# --- Catalog -----------------------------------------------------------------

# Product handles of the two roasts (defaults shown).
MEDIUM_ROAST_HANDLE="medium-roast"
DARK_ROAST_HANDLE="dark-roast"
# Optional: handle of a Shopify bundle product for The Rebel Duo. Leave empty
# to have "Add both to cart" add one Medium and one Dark as two lines.
DUO_PRODUCT_HANDLE=""

# --- Site --------------------------------------------------------------------

# Canonical origin used for canonical URLs, Open Graph and the sitemap.
PUBLIC_SITE_URL="https://www.example.com"
# Set to "false" only if consent is collected by another tool. Defaults to
# Shopify's privacy banner.
PUBLIC_PRIVACY_BANNER="true"

# --- Analytics (all optional; nothing loads when empty) ----------------------

PUBLIC_GA4_MEASUREMENT_ID=""
PUBLIC_GOOGLE_ADS_ID=""
PUBLIC_GOOGLE_ADS_ADD_TO_CART_LABEL=""
PUBLIC_META_PIXEL_ID=""
PUBLIC_TIKTOK_PIXEL_ID=""

# --- Local development only --------------------------------------------------

# "true" serves clearly labelled fixture products and a session cart when no
# store is connected. Only honoured on localhost / 127.0.0.1; ignored in
# production even if set.
MR_DEV_FIXTURES="false"
